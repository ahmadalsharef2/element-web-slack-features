/* LiberMsg on a phone: one pane at a time, like a phone chat app. The room list fills the screen; opening a
   room replaces it, and the back button in the room header returns to the list. LoggedInView sets
   mx_MatrixChat--pageOpen while a room (or any page other than Home) is shown. */

.mx_RoomHeader_back,
.mx_MatrixChat_phoneBack {
    display: none !important;
}

/* Up to tablet width, room info, threads and the member list cover the timeline instead of squeezing it */
@media (max-width: 1024px) {
    .mx_MainSplit {
        position: relative;
    }

    .mx_MainSplit > .mx_RightPanel_ResizeWrapper {
        position: absolute;
        inset-block: 0;
        inset-inline-end: 0;
        z-index: 2;
        width: min(100%, 420px) !important;
        max-width: none !important;
        background-color: var(--cpd-color-bg-canvas-default);
        border-inline-start: 1px solid var(--cpd-color-border-interactive-secondary);
    }
}

@media (max-width: 640px) {
    .mx_RoomHeader_back {
        display: inline-flex !important;
        flex-shrink: 0;
        margin-inline-end: calc(-1 * var(--cpd-space-2x));
    }

    /* The panels are sized inline by the resizable layout, hence !important */
    .mx_MatrixChat--pageOpen {
        .mx_SpacePanel,
        [data-panel]:has(.mx_LeftPanel),
        .mx_Separator {
            display: none !important;
        }

        [data-panel]:has(.mx_RoomView_wrapper) {
            flex: 1 1 100% !important;
        }
    }

    .mx_MatrixChat:not(.mx_MatrixChat--pageOpen) {
        [data-panel]:has(.mx_RoomView_wrapper),
        .mx_Separator {
            display: none !important;
        }

        [data-panel]:has(.mx_LeftPanel) {
            flex: 1 1 100% !important;
        }

        .mx_LeftPanel_panel {
            max-width: none !important;
        }
    }

    .mx_MainSplit > .mx_RightPanel_ResizeWrapper {
        width: 100% !important;
    }

    .mx_RoomHeader {
        padding-inline: var(--cpd-space-2x) var(--cpd-space-3x);
        gap: var(--cpd-space-2x) !important;
    }

    /* Pages without a room header (invites, previews, space home, people, module pages) get a back bar instead */
    .mx_MatrixChat--pageOpen .mx_RoomView_wrapper:not(:has(.mx_RoomHeader)) {
        padding-top: 48px;
        /* The page below fills the rest, not the whole height on top of the bar */
        box-sizing: border-box;

        .mx_MatrixChat_phoneBack {
            display: flex !important;
            align-items: center;
            position: absolute;
            inset: 0 0 auto;
            height: 48px;
            padding-inline: var(--cpd-space-2x);
            z-index: 2;
            border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);
            background-color: var(--cpd-color-bg-canvas-default);
        }
    }

    /* A long press on a message opens our menu (EventTile.tsx), so iOS should not open its own on top of it */
    .mx_EventTile {
        -webkit-touch-callout: none;
    }

    /* Calls, threads and room info stay in the header; search and people are in room info */
    .mx_RoomHeader .mx_RoomHeader_info {
        padding-right: 0;
    }

    /* FacePile does not pass its class name on, so the member list button is found by what it contains */
    .mx_RoomHeader_search,
    .mx_RoomHeader :has(> .mx_FacePile) {
        display: none !important;
    }

    /* Dialogs use the whole width of the screen */
    .mx_Dialog_fixedWidth {
        width: calc(100vw - 2 * var(--cpd-space-4x)) !important;
        max-width: none !important;
    }

    /* Dialogs that set their own width stay inside the screen too. These rules start with :root because the
       stylesheets they override load after this one. */
    :root .mx_Dialog {
        padding: var(--cpd-space-6x) var(--cpd-space-4x);
        max-width: 100vw;
    }

    :root .mx_UploadConfirmDialog_previewInner {
        width: 100%;
    }

    .mx_ForwardDialog,
    .mx_ShareDialog,
    .mx_ServerPickerDialog,
    .mx_CreateSecretStorageDialog,
    .mx_InviteDialog_transfer .mx_InviteDialog_content,
    .mx_SpacePreferencesDialog {
        width: auto !important;
        max-width: 100% !important;
    }

    /* Settings fill the screen, with the tabs in a row along the top instead of a column down the side */
    :root :is(.mx_UserSettingsDialog, .mx_RoomSettingsDialog, .mx_SpaceSettingsDialog, .mx_SpacePreferencesDialog) {
        width: 100vw !important;
        height: 100dvh;
        max-height: none;
        border-radius: 0;

        .mx_TabbedView {
            top: 64px;
            padding-left: var(--cpd-space-4x);
        }

        .mx_TabbedView .mx_SettingsTab {
            min-width: 0;
            padding-right: var(--cpd-space-4x);
        }
    }

    :root .mx_TabbedView_tabsOnLeft {
        .mx_TabbedView_tabLabels {
            position: static;
            display: flex;
            width: auto !important;
            max-width: none;
            overflow-x: auto;
            flex-shrink: 0;
            margin-bottom: var(--cpd-space-2x);
        }

        .mx_TabbedView_tabLabel {
            flex-shrink: 0;
        }

        .mx_TabbedView_tabPanel {
            margin-left: 0 !important;
        }
    }
}
