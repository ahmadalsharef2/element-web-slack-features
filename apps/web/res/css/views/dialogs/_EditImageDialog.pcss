.mx_EditImageDialog {
    max-width: min(900px, 100%);
}

.mx_EditImageDialog_tools,
.mx_EditImageDialog_colors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-2x);
    margin-bottom: var(--cpd-space-3x);
}

.mx_EditImageDialog_color {
    width: 28px;
    height: 28px;
    padding: 0;
    border-radius: 50%;
    border: 2px solid var(--cpd-color-border-interactive-secondary);
    cursor: pointer;

    &[aria-checked="true"] {
        outline: 3px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }
}

.mx_EditImageDialog_stage {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
}

.mx_EditImageDialog_canvas {
    display: block;
    max-width: 100%;
    max-height: 60vh;
    /* Drawing with a finger must not scroll or zoom the page */
    touch-action: none;
    cursor: crosshair;
}

.mx_EditImageDialog_textInput {
    position: absolute;
    min-width: 8em;
    font: var(--cpd-font-body-lg-semibold);
    background: rgb(0 0 0 / 50%);
    border: 1px dashed var(--cpd-color-border-interactive-primary);
    border-radius: 4px;
    padding: 2px var(--cpd-space-1x);
}

.mx_EditImageDialog_hint {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
    margin-top: var(--cpd-space-2x);
}
