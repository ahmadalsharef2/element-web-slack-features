/* The bytEM tab: the bytEM PWA's demand side (search, map, legend, DEID panel), its styles copied from the PWA. */

.mx_BytemTab {
    --color-ink: #14243a;
    --color-text: #243248;
    --color-text-muted: #627086;
    --color-primary: #0066cc;
    --color-primary-strong: #0757b7;
    --color-primary-soft: #eaf3ff;
    --color-surface: #ffffff;
    --color-border: #dce4ef;
    --color-border-strong: #c8d4e3;
    --shadow-card: 0 10px 28px rgb(30, 54, 85, 0.07);
    --shadow-card-hover: 0 16px 34px rgb(20, 63, 114, 0.13);
    --radius-sm: 10px;

    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    color: var(--color-text);
    background: var(--color-surface);

    * {
        box-sizing: border-box;
    }
}

/* Search and the markets, above the map */
.mx_BytemTab .indexTools {
    padding: 12px 14px;
    display: grid;
    gap: 10px;
    border-bottom: 1px solid var(--color-border);
}

.mx_BytemTab .indexSearchRow {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 10px 14px;
}

.mx_BytemTab .indexSearchField {
    flex: 1 1 260px;
    display: grid;
    gap: 7px;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 700;
}

.mx_BytemTab .indexSearchField input {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.92rem;
    font-weight: 400;
}

.mx_BytemTab .indexSearchField input::placeholder {
    color: var(--color-text-muted);
}

.mx_BytemTab .indexSearchField input:hover,
.mx_BytemTab .indexSearchField input:focus {
    border-color: var(--color-primary);
}

.mx_BytemTab .indexChips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.mx_BytemTab .indexChip {
    min-height: 36px;
    padding: 0 11px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: #f6f9fe;
    color: var(--color-primary-strong);
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
}

.mx_BytemTab .indexChip span {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
}

.mx_BytemTab .indexChip button {
    padding: 0 2px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
}

.mx_BytemTab .indexChipError {
    border-color: #d4380d;
    color: #d4380d;
}

.mx_BytemTab .indexChipAdd input {
    width: 190px;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    outline: none;
}

/* The map fills what is left; the legend and the selected DEID sit over it */
.mx_BytemTab .indexMapBox {
    position: relative;
    flex: 1;
    min-height: 300px;
    overflow: hidden;
}

.mx_BytemTab .landingPageMap,
.mx_BytemTab .landingPageMapFrame {
    position: absolute;
    inset: 0;
}

.mx_BytemTab .landingPageMapLegend {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 250px;
    max-height: calc(100% - 20px);
    overflow-y: auto;
    z-index: 1000;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    border-radius: 8px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-text-muted);
    font-size: 0.8rem;
}

.mx_BytemTab .landingPageMapCount {
    color: var(--color-ink);
}

/* One row per class: its icon, its name, how many are in view; a click hides or shows it */
.mx_BytemTab .landingPageMapClass {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 2px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
}

.mx_BytemTab .landingPageMapClass small {
    margin-left: auto;
    padding-left: 6px;
    font-variant-numeric: tabular-nums;
}

.mx_BytemTab .landingPageMapClass[aria-pressed="false"] {
    opacity: 0.4;
    text-decoration: line-through;
}

.mx_BytemTab .landingPageMapMore {
    align-self: start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font: inherit;
    cursor: pointer;
}

.mx_BytemTab .landingPageMapPicking .leaflet-container {
    cursor: crosshair;
}

.mx_BytemTab .landingPageMapUnplaced {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-top: 7px;
    border-top: 1px solid var(--color-border-strong);
}

.mx_BytemTab .landingPageMapUnplaced [aria-current] {
    font-weight: 700;
}

.mx_BytemTab .landingPageMapIconWrap {
    background: none;
    border: 0;
}

.mx_BytemTab .landingPageMapIcon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: 2px solid;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0, 0, 0, 0.3);
}

.mx_BytemTab .landingPageMapIcon img {
    width: 76%;
    height: 76%;
}

.mx_BytemTab .landingPageMapLegend .landingPageMapIcon {
    flex-shrink: 0;
    display: inline-flex;
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

/* The selected DEID: a box inside the map */
.mx_BytemTab .deidPanel {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1000;
    width: min(400px, calc(100% - 24px));
    max-height: calc(100% - 24px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card-hover);
}

.mx_BytemTab .deidPanelHeader {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 16px 12px 14px 16px;
    border-bottom: 1px solid var(--color-border);
}

.mx_BytemTab .deidPanelHeadline {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 4px;
}

.mx_BytemTab .deidPanelHeadline h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
}

.mx_BytemTab .deidPanelHeadline code {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    word-break: break-all;
}

.mx_BytemTab .deidPanelClose {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
}

.mx_BytemTab .deidPanelClose:hover,
.mx_BytemTab .deidPanelClose:focus-visible {
    background: var(--color-primary-soft);
    color: var(--color-ink);
}

.mx_BytemTab .deidPanelSection {
    padding: 14px 16px;
    font-size: 0.875rem;
}

.mx_BytemTab .deidPanelExchange {
    display: block;
    width: 100%;
    padding: 10px 14px;
    border: 0;
    border-radius: 8px;
    background: var(--color-primary);
    color: #fff;
    font: inherit;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
}

.mx_BytemTab .deidPanelExchange:disabled {
    opacity: 0.6;
    cursor: default;
}

.mx_BytemTab .deidPanelNote {
    margin: 8px 0 0;
    color: var(--color-text-muted);
}

.mx_BytemTab .deidPanelPrompt {
    margin: 0 0 10px;
    color: var(--color-primary);
    font-size: 1rem;
    font-weight: 600;
}

/* The space bar icon: the bytEM logo on a white square */
.mx_SpaceButton .mx_BytemTab_icon {
    width: 100%;
    border-radius: 4px;
}
