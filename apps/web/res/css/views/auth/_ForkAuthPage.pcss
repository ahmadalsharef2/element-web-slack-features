/* Element Fork's sign-in pages sit on a light background (themes/element/img/backgrounds/brand.svg), so the
   footer drops the dark band that kept its links readable over Element's lake photo. */
.mx_AuthFooter {
    background: none;
    opacity: 1;
}

.mx_AuthFooter a:link,
.mx_AuthFooter a:hover,
.mx_AuthFooter a:visited {
    color: var(--cpd-color-text-secondary);
}

/* On a phone the welcome card's fixed-width buttons ran off the right edge of the screen */
@media (max-width: 480px) {
    /* :root outranks _Welcome.pcss, which is imported after this file */
    :root .mx_Welcome {
        padding-inline: var(--cpd-space-6x);
    }

    .mx_DefaultWelcome,
    .mx_DefaultWelcome_buttons {
        width: 100%;
    }

    .mx_DefaultWelcome .mx_DefaultWelcome_buttons a {
        width: 100%;
        box-sizing: border-box;
    }
}
