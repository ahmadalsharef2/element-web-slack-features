/* LiberMsg's sign-in pages sit on a light background (themes/element/img/backgrounds/brand.svg), so the
   footer drops the dark band that kept its links readable over Element's lake photo. */
.mx_AuthFooter {
    background: none;
    opacity: 1;
}

.mx_AuthFooter a:link,
.mx_AuthFooter a:hover,
.mx_AuthFooter a:visited {
    color: var(--cpd-color-text-secondary);
}

/* On a phone the welcome card's fixed-width buttons ran off the right edge of the screen */
@media (max-width: 480px) {
    /* :root outranks _Welcome.pcss, which is imported after this file */
    :root .mx_Welcome {
        padding-inline: var(--cpd-space-6x);
    }

    .mx_DefaultWelcome,
    .mx_DefaultWelcome_buttons {
        width: 100%;
    }

    .mx_DefaultWelcome .mx_DefaultWelcome_buttons a {
        width: 100%;
        box-sizing: border-box;
    }

    /* Upstream pins the card to the top edge on phones; centre it with a margin all round instead */
    :root .mx_AuthPage_modal {
        margin: auto var(--cpd-space-4x);
    }

    /* The footer's links wrap whole, one below the other when they do not fit side by side */
    :root .mx_AuthFooter a {
        display: inline-block;
        margin: var(--cpd-space-1x) var(--cpd-space-3x);
        white-space: nowrap;
    }
}

:root .mx_AuthPage {
    box-sizing: border-box;
    /* The variables are set in _ForkLook.pcss; the 0px says what to use should that file ever not load */
    padding: var(--fork-safe-top, 0px) var(--fork-safe-right, 0px) var(--fork-safe-bottom, 0px)
        var(--fork-safe-left, 0px);
}
