/* LiberMsg look, on top of the brand colours in res/themes/brand/_brand.pcss. Kept in one file so upstream's
   stylesheets stay untouched. The rules start at :root so they win over upstream's, whichever file loads last. */

/* Text links are blue, so they read as links and not as bold text */
:root .mx_AccessibleButton.mx_AccessibleButton_kind_link,
:root .mx_AccessibleButton.mx_AccessibleButton_kind_link_inline {
    color: var(--cpd-color-text-action-accent);
}

/* The message box is a box: outlined, rounded, and highlighted while you type in it */
:root .mx_MessageComposer_wrapper {
    margin: 0 var(--cpd-space-4x) var(--cpd-space-3x);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 12px;
    background-color: var(--cpd-color-bg-canvas-default);
    transition: border-color 0.1s;

    &:focus-within {
        border-color: var(--cpd-color-border-accent-primary);
    }
}

/* In threads and other narrow panels the box keeps a little room inside */
:root .mx_MessageComposer.mx_MessageComposer--compact .mx_MessageComposer_wrapper {
    margin-inline: 0;
}

:root .mx_MessageComposer.mx_MessageComposer--compact:not(.mx_MessageComposer_e2eStatus) .mx_MessageComposer_wrapper {
    padding-inline: var(--cpd-space-3x);
}

/* The space bar on the far left is a navy brand rail in every theme. SpacePanel.tsx gives it the dark Compound theme,
   so its icons, text and badges are already drawn for a dark background; this sets the navy behind them. */
:root .mx_SpacePanel {
    --cpd-color-bg-canvas-default: #0b2a4a;
    background-color: #0b2a4a;
    border-right: none;
}

/* Avatars are rounded squares rather than Element's circles, for people as well as rooms. Compound draws every
   avatar with this radius; rooms and spaces already use 25%. */
:root [class*="_avatar_"][data-type="round"] {
    --cpd-avatar-radius: 30%;
}

/* The open room is marked in a tint of the brand blue, not grey */
:root .mx_RoomListItemView {
    --cpd-color-bg-action-tertiary-selected: var(--cpd-color-blue-300);
}

/* Keep the app clear of the status bar, notch and gesture bar. The page asks to draw edge to edge
   (viewport-fit=cover), so phone browsers report env(safe-area-inset-*) and the Android app (mobile/) sets the
   --safe-area-inset-* variables instead; both are 0 on a desktop. */
:root {
    --fork-safe-top: max(env(safe-area-inset-top, 0px), var(--safe-area-inset-top, 0px));
    --fork-safe-right: max(env(safe-area-inset-right, 0px), var(--safe-area-inset-right, 0px));
    --fork-safe-bottom: max(env(safe-area-inset-bottom, 0px), var(--safe-area-inset-bottom, 0px));
    --fork-safe-left: max(env(safe-area-inset-left, 0px), var(--safe-area-inset-left, 0px));
}

/* The sign-in pages pad themselves (below), so their background reaches under the bars */
:root #matrixchat:not(:has(.mx_AuthPage)) {
    box-sizing: border-box;
    padding: var(--fork-safe-top) var(--fork-safe-right) var(--fork-safe-bottom) var(--fork-safe-left);
}
