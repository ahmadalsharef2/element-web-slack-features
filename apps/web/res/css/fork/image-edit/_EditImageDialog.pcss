.mx_EditImageDialog {
    max-width: min(900px, 100%);
}

.mx_EditImageDialog_tools,
.mx_EditImageDialog_options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--cpd-space-2x) var(--cpd-space-4x);
    margin-bottom: var(--cpd-space-3x);
}

.mx_EditImageDialog_colors,
.mx_EditImageDialog_sizes {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
}

.mx_EditImageDialog_size {
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 8px;
    background: none;
    color: var(--cpd-color-text-primary);
    font-weight: bold;
    cursor: pointer;

    &[aria-checked="true"] {
        border-color: var(--cpd-color-border-focused);
        background-color: var(--cpd-color-bg-subtle-secondary);
    }
}

.mx_EditImageDialog_size_small {
    font-size: 12px;
}

.mx_EditImageDialog_size_medium {
    font-size: 17px;
}

.mx_EditImageDialog_size_large {
    font-size: 24px;
}

.mx_EditImageDialog_color {
    width: 28px;
    height: 28px;
    padding: 0;
    border-radius: 50%;
    border: 2px solid var(--cpd-color-border-interactive-secondary);
    cursor: pointer;

    &[aria-checked="true"] {
        outline: 3px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }
}

.mx_EditImageDialog_stage {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
}

.mx_EditImageDialog_canvas {
    display: block;
    max-width: 100%;
    max-height: 60vh;
    /* Drawing with a finger must not scroll or zoom the page */
    touch-action: none;
    cursor: crosshair;
}

.mx_EditImageDialog_textInput {
    position: absolute;
    /* Font, size, colour and outline are set inline to match the text the canvas will draw */
    min-width: 4ch;
    box-sizing: content-box;
    padding: 0;
    border: none;
    background: none;
    line-height: 1.2;
    paint-order: stroke fill;
    outline: 2px dashed rgb(255 255 255 / 85%);
    outline-offset: 4px;
    box-shadow: 0 0 0 6px rgb(0 0 0 / 25%);

    &::placeholder {
        color: inherit;
        opacity: 0.6;
    }
}

.mx_EditImageDialog_hint {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
    margin-top: var(--cpd-space-2x);
}

/* On a phone the five tools fit on one row: the words stay, the icons go */
@media (max-width: 640px) {
    .mx_EditImageDialog_tools {
        gap: var(--cpd-space-1-5x);

        button {
            padding-inline: var(--cpd-space-3x);

            svg {
                display: none;
            }
        }
    }
}
